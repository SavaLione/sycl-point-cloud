# sycl-point-cloud git ignore file
# This file specifies intentionally untracked files that Git should ignore

# Build artifacts
/build/
paper/build/

# Ignore other common build outputs and binaries that might be created outside the build dir
*.exe
*.out
*.a
*.so
*.dll
*.o
*.obj
*.lib
*.pdb
*.ilk

# CMake generated files
# The config.h is generated from config.h.in
/src/config.h

# Clangd language server cache
.cache/
compile_commands.json

# Log files
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
